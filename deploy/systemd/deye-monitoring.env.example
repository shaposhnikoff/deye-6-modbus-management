# /etc/deye-monitoring.env — the single source of truth for both services.
# Every key is optional; the code falls back to the defaults shown here.
# Copy to /etc/deye-monitoring.env, edit, chmod 600, then: systemctl restart deye-monitoring deye-mqtt

# --- serial line -----------------------------------------------------------
#DEYE_PORT=/dev/modbus
#DEYE_BAUD=9600
#DEYE_SLAVE=1

# --- collector: deye-monitoring.service ------------------------------------
DEYE_LISTEN=0.0.0.0:9101
DEYE_INTERVAL=10
DEYE_CACHE_PATH=/run/deye/state.json
DEYE_NOTIFY=1
#DEYE_LOG_LEVEL=INFO

# --- telegram --------------------------------------------------------------
#DEYE_TELEGRAM_TOKEN=123456:AA-your-token
#DEYE_TELEGRAM_CHAT_ID=123456789
#DEYE_TEMP_WARNING_C=65
#DEYE_STALE_SECONDS=120
#DEYE_NOTIFY_COOLDOWN=1800

# --- mqtt bridge: deye-mqtt.service ----------------------------------------
#DEYE_MQTT_HOST=192.168.10.68
#DEYE_MQTT_PORT=1883
#DEYE_MQTT_USER=
#DEYE_MQTT_PASSWORD=
#DEYE_MQTT_PREFIX=homeassistant
#DEYE_MQTT_NODE=deye_6k
