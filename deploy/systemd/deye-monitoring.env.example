# Copy to /etc/deye-monitoring.env and adjust. Every value is optional:
# the exporter falls back to its built-in defaults.

# Serial device and Modbus line settings
#DEYE_PORT=/dev/modbus
#DEYE_BAUD=9600
#DEYE_SLAVE=1

# HTTP listener and poll interval
#DEYE_LISTEN=0.0.0.0:9101
#DEYE_INTERVAL=10

# Telegram notifications (optional, see docs/ALERTS.md)
#DEYE_TELEGRAM_TOKEN=
#DEYE_TELEGRAM_CHAT_ID=
