[Unit]
Description=Deye inverter collector and Prometheus exporter
Documentation=https://github.com/shaposhnikoff/deye-6-modbus-management
After=network-online.target dev-modbus.device
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=max
Group=max
WorkingDirectory=/home/max
EnvironmentFile=-/etc/deye-monitoring.env
RuntimeDirectory=deye
RuntimeDirectoryMode=0750
ExecStart=/home/max/DEYEMonitoring/.venv/bin/dmon serve
Restart=always
RestartSec=15
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
